{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://h0p3.io/gallery/bura-ceramics/panel.schema.json",
  "title": "AABC Gallery Research Panels",
  "description": "Schema for a set of gallery wall panels/posters. Each panel record is the content source a single physical poster pulls from.",
  "type": "object",
  "required": ["collection", "panels"],
  "properties": {
    "$schema": { "type": "string" },
    "collection": {
      "type": "object",
      "required": ["id", "title", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "anchorArtifact": { "type": "string" },
        "anchorArtifactSource": {
          "type": "object",
          "description": "Provenance of the physical artifact anchoring the gallery (the Bura face in the 3D scene).",
          "properties": {
            "institution": { "type": "string" },
            "object": { "type": "string" },
            "date": { "type": "string" },
            "medium": { "type": "string" },
            "accession": { "type": "string" },
            "creditLine": { "type": "string" },
            "license": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "note": { "type": "string" }
          }
        },
        "purpose": { "type": "string" },
        "version": { "type": "string" },
        "generated": { "type": "string" },
        "researchMethod": { "type": "string" },
        "curatorialNotes": { "type": "array", "items": { "type": "string" } },
        "imageLicensingPolicy": { "type": "string" },
        "demoUsagePolicy": { "type": "string" }
      }
    },
    "schema": { "type": "object" },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/panel" }
    },
    "bibliography": {
      "type": "array",
      "items": { "$ref": "#/definitions/source" }
    }
  },
  "definitions": {
    "panel": {
      "type": "object",
      "required": ["id", "name", "title", "description", "sources"],
      "properties": {
        "id": { "type": "string", "description": "Short panel code, e.g. 'A'." },
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Stable kebab-case key the display binds to." },
        "placardLabel": { "type": "string", "description": "Human label of the in-scene placard this panel binds to (e.g. 'Bura Placard A')." },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "format": { "type": "string", "description": "Intended visual treatment." },
        "panelCaption": { "type": "string" },
        "description": { "type": "string", "description": "Primary readable block (~40–80 words)." },
        "body": { "type": "string", "description": "Optional longer narrative." },
        "keyFacts": { "type": "array", "items": { "type": "string" } },
        "images": { "type": "array", "items": { "$ref": "#/definitions/image" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } },
        "usageNote": { "type": "string", "description": "If present, the panel relies on un-cleared or illustration-pending visuals; the renderer stamps it 'For demo purposes only — not for distribution'." },
        "design": {
          "type": "object",
          "properties": {
            "palette": { "type": "string" },
            "layout": { "type": "string" },
            "illustration": { "type": "string" }
          }
        },
        "status": { "type": "string", "enum": ["draft", "needs-image-clearance", "needs-illustration", "ready"] }
      }
    },
    "image": {
      "type": "object",
      "required": ["url", "caption"],
      "properties": {
        "url": { "type": "string", "description": "Absolute URL or path relative to panels.json (e.g. ./assets/foo.jpg)." },
        "caption": { "type": "string" },
        "credit": { "type": "string" },
        "license": { "type": "string", "description": "Rights status; must be cleared before printing." },
        "role": { "type": "string", "enum": ["hero", "supporting", "reference"] }
      }
    },
    "source": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "name": { "type": "string", "description": "Short label." },
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri", "description": "Optional; bibliography entries may omit it." },
        "publisher": { "type": "string" }
      }
    }
  }
}
